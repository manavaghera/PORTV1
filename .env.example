# Environment for the portfolio's /api functions.
# On Vercel: Project → Settings → Environment Variables. Locally: copy to .env.local (git-ignored)
# and run `npm run dev`. Never commit real values.

# Admin sign-in for /admin — pick your own; the password needs 10+ characters.
ADMIN_ID=
ADMIN_PASSWORD=
# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Storage: Vercel → Storage → Create Database → Upstash for Redis → connect it to this project.
# That adds these two automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email: resend.com → API Keys. Until you verify a domain, Resend only delivers to the address
# you signed up with — so sign up with the inbox you want messages in.
RESEND_API_KEY=
CONTACT_TO=manavaghera@yahoo.com
# Once a domain is verified in Resend, you can send from it:
# CONTACT_FROM=Portfolio <hello@your-domain.com>

# Publish kind words immediately instead of waiting for approval on /admin:
# KIND_AUTO_PUBLISH=1
